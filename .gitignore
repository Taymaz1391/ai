import argparse

import torch

from chat import generate_reply
from model import ByteTokenizer, load_checkpoint


class LocalMemoryAgent:
    def __init__(self, model, limit: int = 20):
        self.model = model
        self.memory = []
        self.limit = limit

    def remember(self, user_input: str, answer: str):
        self.memory.append({"user": user_input, "answer": answer})
        if len(self.memory) > self.limit:
            self.memory.pop(0)

    def context_for(self, prompt: str):
        if not self.memory:
            return ""
        snippet = "\n".join([
            f"User: {item['user']}\nAgent: {item['answer']}" for item in self.memory[-5:]
        ])
        return f"History:\n{snippet}\n\nCurrent request:\n{prompt}\n"

    def answer(self, prompt: str, **kwargs):
        full_prompt = self.context_for(prompt)
        answer = generate_reply(self.model, full_prompt, **kwargs)
        self.remember(prompt, answer)
        return answer


def main():
    parser = argparse.ArgumentParser(description="Run a local memory agent based on a checkpoint.")
    parser.add_argument("--checkpoint", required=True)
    parser.add_argument("--max-new-tokens", type=int, default=200)
    parser.add_argument("--temperature", type=float, default=0.8)
    parser.add_argument("--top-k", type=int, default=50)
    parser.add_argument("--top-p", type=float, default=0.95)
    args = parser.parse_args()

    device = "cuda" if torch.cuda.is_available() else "cpu"
    model = load_checkpoint(args.checkpoint, device=device)
    agent = LocalMemoryAgent(model)

    print("Local Memory Agent ready. Type 'exit' or 'خروج' to quit.")
    while True:
        user_input = input("You: ")
        if user_input.strip().lower() in {"exit", "quit", "خروج"}:
            break
        if not user_input.strip():
            continue
        answer = agent.answer(
            user_input,
            max_new_tokens=args.max_new_tokens,
            temperature=args.temperature,
            top_k=args.top_k,
            top_p=args.top_p,
        )
        print(f"Agent: {answer}")


if __name__ == "__main__":
    main()
