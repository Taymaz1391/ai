# محیط اجرا
.venv/
__pycache__/
*.pyc
.pytest_cache/

# داده‌های خام/ساخت‌شده (با اسکریپت بازسازی می‌شوند)
data/train.txt
data/val.txt
corpora/
*.tar.gz

# checkpointهای موقت (نسخهٔ نهایی در مخزن می‌ماند)
checkpoints/*.tmp
checkpoints/*.npz.tmp

# گزارش‌های موقت
logs/*.log
logs/*.pid

# نسخه‌های میانی وزن‌ها
checkpoints/*-step*.npz

# خروجی سایت استاتیک (GitHub Pages)
_site/

# پایگاه‌دادهٔ محلی و وابستگی‌های آزمون رابط
data/*.sqlite3
data/admin.json
data/backups/
data/*.sqlite3-shm
data/*.sqlite3-wal
tests/ui/node_modules
node_modules/

# اعتبارنامهٔ مالک (هش scrypt؛ هرگز در Git نمی‌رود)
data/owner.json
data/owner.json.tmp

# رازِ امضای سرور (خودکار ساخته می‌شود)
data/secret.key

# وضعیت ابزار مقیاس‌پذیری (محلی)
data/.scale_state.json
data/.scale_seen.txt
data/scale_stats.json

# رویدادهای سد تهاجم (زمان اجرا)
data/security_events.jsonl
data/security_events.jsonl.1

# پیکرهٔ توکن‌شده و checkpointهای در جریان آموزش (با اسکریپت بازسازی می‌شوند)
data/*.u16
checkpoints/*.tmp.npz
# وزن‌های نهایی (last.npz) عمداً در مخزن می‌مانند تا سایت بدون آموزش هم بالا بیاید
# گزارش کامل اجرای نسخهٔ ۲ به‌عنوان شاهد آموزش در مخزن می‌ماند
