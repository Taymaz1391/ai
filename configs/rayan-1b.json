{
  "name": "رایان ۱ میلیارد پارامتری",
  "note": "این فایل مشخصاتِ معماریِ نسخهٔ ۱ میلیارد پارامتری است. اعداد پارامتر و زمان با scripts/plan_1b.py محاسبه می‌شود؛ هیچ عددی دستی نوشته نشده. آموزشِ این مدل روی CPU ممکن نیست و به GPU نیاز دارد.",
  "model": {
    "arch": "decoder-only transformer",
    "vocab_size": 32000,
    "block_size": 2048,
    "n_layer": 20,
    "n_head": 16,
    "n_embd": 2048,
    "ffn_mult": 4,
    "tie_embeddings": true,
    "norm": "rmsnorm",
    "activation": "swiglu",
    "rope": true,
    "precision": "bf16"
  },
  "data": {
    "target_tokens": 21440000000,
    "tokens_per_param": 20,
    "chars_per_token": 2.2,
    "sources": [
      "پیکرهٔ ویکی‌پدیای فارسی (بازبینی‌شده)",
      "پیکرهٔ خبری فارسی با مجوز",
      "پیکرهٔ گفتگو و پرسش‌وپاسخ فارسی",
      "دادهٔ دستورِ ساخت‌یافتهٔ خودِ پروژه"
    ]
  },
  "train": {
    "optimizer": "adamw",
    "betas": [0.9, 0.95],
    "weight_decay": 0.1,
    "learning_rate": 3e-4,
    "warmup_steps": 2000,
    "schedule": "cosine",
    "global_batch_tokens": 2097152,
    "grad_clip": 1.0
  },
  "hardware_scenarios": [
    {"name": "۸×H100 80GB", "tokens_per_second": 1000000, "hourly_usd": 20},
    {"name": "۸×A100 80GB", "tokens_per_second": 450000, "hourly_usd": 10},
    {"name": "۱×A100 80GB", "tokens_per_second": 55000, "hourly_usd": 1.2}
  ],
  "eval": {
    "benchmarks": ["arena", "دستور زبان", "کد", "دانش عمومی"],
    "report": "reports/upgrade-1b.json"
  }
}
